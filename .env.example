# Supabase (Postgres + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — Claude (primary) with OpenAI fallback.
# No AI calls are implemented in Sprint 1; these are placeholders for Sprint 2+.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Scheduled batch automation (Phase 10) — read by scripts/run-scheduled-batch.ts
# (a GitHub Actions job, scheduled or manually dispatched; never the local
# dev app). Not a fifth "organization" value: organizationId is always
# derived from BATCH_OWNER_PROFILE_ID's own default_organization_id, so
# there is deliberately no separate BATCH_ORGANIZATION_ID to keep in sync.
BATCH_OWNER_PROFILE_ID=
BATCH_LOCATION=
BATCH_REQUESTED_COUNT=
BATCH_MAX_ATTEMPTS=

# Future sprints (not used yet):
# Gmail API (email drafting)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub (deployment pipeline)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Stripe (billing)
STRIPE_SECRET_KEY=
# Cloudflare (deployment)
CLOUDFLARE_API_TOKEN=
